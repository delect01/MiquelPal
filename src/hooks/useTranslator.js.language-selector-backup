import {
  useEffect,
  useMemo,
  useState
} from "react";
import {
  getLanguageDirection,
  getTranslator,
  SUPPORTED_LANGUAGES
} from "../i18n/traductor.js";

const LANGUAGE_STORAGE_KEY =
  "pallet-simulator-language";

function getInitialLanguage(
  fallbackLanguage
) {
  try {
    const storedLanguage =
      window.localStorage.getItem(
        LANGUAGE_STORAGE_KEY
      );

    const isSupported =
      SUPPORTED_LANGUAGES.some(
        (language) =>
          language.code ===
          storedLanguage
      );

    return isSupported
      ? storedLanguage
      : fallbackLanguage;
  } catch {
    return fallbackLanguage;
  }
}

export default function useTranslator(
  initialLanguage = "ca"
) {
  const [
    activeLanguage,
    setActiveLanguage
  ] = useState(() =>
    getInitialLanguage(
      initialLanguage
    )
  );

  const t = useMemo(
    () =>
      getTranslator(activeLanguage),
    [activeLanguage]
  );

  const languageDirection = useMemo(
    () =>
      getLanguageDirection(
        activeLanguage
      ),
    [activeLanguage]
  );

  useEffect(() => {
    try {
      window.localStorage.setItem(
        LANGUAGE_STORAGE_KEY,
        activeLanguage
      );
    } catch {
      // L'aplicacio continua funcionant
      // encara que localStorage no estigui disponible.
    }

    document.documentElement.lang =
      activeLanguage;

    document.documentElement.dir =
      languageDirection;
  }, [
    activeLanguage,
    languageDirection
  ]);

  return {
    activeLanguage,
    setActiveLanguage,
    languageDirection,
    availableLanguages:
      SUPPORTED_LANGUAGES,
    t
  };
}
