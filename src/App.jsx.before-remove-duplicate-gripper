useEffect(() => {
  
  function handleGlobalKeyDown(
    event
  ) {
    const activeElement =
      document.activeElement;

    const isWritingInField =
      activeElement instanceof
        HTMLInputElement ||
      activeElement instanceof
        HTMLTextAreaElement ||
      activeElement instanceof
        HTMLSelectElement ||
      activeElement
        ?.isContentEditable ===
        true;

    /*
      No executem dreceres mentre
      s'està editant un camp.
    */
    if (isWritingInField) {
      return;
    }

    const openDialog =
      document.querySelector(
        '[role="dialog"][aria-modal="true"]'
      );

      

    if (openDialog) {
      return;
    }

const pressedKey =
  event.key.toLowerCase();

const isUndoShortcut =
  event.ctrlKey &&
  !event.shiftKey &&
  pressedKey === "z";

const isRedoShortcut =
  event.ctrlKey &&
  (
    pressedKey === "y" ||
    (
      event.shiftKey &&
      pressedKey === "z"
    )
  );

if (isUndoShortcut) {
  event.preventDefault();

  undoPieces();

  return;
}

if (isRedoShortcut) {
  event.preventDefault();

  redoPieces();

  return;
}


    const keyboardMoveHandled =
  moveSelectionWithKeyboard({
    event,
    selectedPieceIds,
    setPieces
  });

if (
  keyboardMoveHandled
) {
  return;
}

    /*
      Seleccionar totes les peces
      i separadors de la composició.
    */
    if (
      event.ctrlKey &&
      event.key.toLowerCase() ===
        "a" &&
      activeConfigurator !==
        "palletizing"
    ) {
      event.preventDefault();

      applyPieceSelection(
        pieces.map(
          (piece) =>
            piece.id
        )
      );

      return;
    }

    /*
      Dreceres específiques del
      configurador de paletitzat.
    */
    if (
      activeConfigurator ===
      "palletizing"
    ) {
      if (
        event.key ===
        "Escape"
      ) {
        if (
          selectedPalletizingInstanceId ===
          null
        ) {
          return;
        }

        event.preventDefault();

        setSelectedPalletizingInstanceId(
          null
        );

        return;
      }



      if (
        event.key ===
        "Delete"
      ) {
        if (
          selectedPalletizingInstanceId ===
          null
        ) {
          return;
        }

        event.preventDefault();

        deletePalletizingLayer(
          selectedPalletizingInstanceId
        );

        return;
      }

      return;
    }

    /*
      Escape cancel·la el rectangle
      o neteja la selecció.
    */
    if (
      event.key ===
      "Escape"
    ) {
      if (
        selectionRectangleRef.current
      ) {
        event.preventDefault();

        selectionRectangleRef.current =
          null;

        setSelectionRectangle(
          null
        );

        setIsDragging(
          false
        );

        return;
      }

      if (
        selectedPieceIds.length ===
        0
      ) {
        return;
      }

      event.preventDefault();

      clearPieceSelection();

      return;
    }

    /*
      Supr elimina totes les peces i
      separadors seleccionats.

      Després, els orderId restants
      es renumeren automàticament.
    */
    if (
      event.key ===
      "Delete"
    ) {
      if (
        selectedPieceIds.length ===
        0
      ) {
        return;
      }

      event.preventDefault();

      deleteSelectedPieces();

      return;
    }
  }

  window.addEventListener(
    "keydown",
    handleGlobalKeyDown
  );

  return () => {
    window.removeEventListener(
      "keydown",
