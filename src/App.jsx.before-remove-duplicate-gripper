function selectPiece(
  pieceId,
  additive = false
) {
  if (!additive) {
    applyPieceSelection([
      pieceId
    ]);

    return;
  }

  setSelectedPieceIds(
    (currentIds) => {
      const alreadySelected =
        currentIds.includes(
          pieceId
        );

      const nextIds =
        alreadySelected
          ? currentIds.filter(
              (currentId) =>
                currentId !==
                pieceId
            )
          : [
              ...currentIds,
              pieceId
            ];

      setSelectedPieceId(
        nextIds.length === 1
          ? nextIds[0]
          : null
      );

      return nextIds;
    }
  );
}

function startPieceDrag(
  pieceId,
  startThreeX,
  startThreeZ
) {
  beginPiecesTransaction();

  const sourcePiece =
    pieces.find(
      (piece) =>
        piece.id === pieceId
    );

  if (!sourcePiece) {
    endPiecesTransaction();
    return;
}

  const movingPieceIds =
    selectedPieceIds.includes(
      pieceId
    )
      ? selectedPieceIds
      : [
          pieceId
        ];

  if (
    !selectedPieceIds.includes(
      pieceId
    )
  ) {
    applyPieceSelection([
      pieceId
    ]);
  }

  const initialPositions =
    new Map(
      pieces
        .filter(
          (piece) =>
            movingPieceIds.includes(
              piece.id
            )
        )
        .map(
          (piece) => [
            piece.id,
            {
              x:
                Number(piece.x) ||
                0,
              y:
                Number(piece.y) ||
                0
            }
          ]
        )
    );

  const startPalletPosition =
    threeToPallet(
      startThreeX,
      0,
      startThreeZ
    );

  groupDragRef.current = {
    sourcePieceId:
      pieceId,

    movingPieceIds,

    initialPositions,

    startPalletX:
      startPalletPosition.x,

    startPalletY:
      startPalletPosition.y
  };

  setIsDragging(true);
}




