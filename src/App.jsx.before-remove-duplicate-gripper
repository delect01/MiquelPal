}

// Elimina la peça seleccionada
function deleteSelectedPieces() {
  if (
    selectedPieceIds.length ===
      0
  ) {
    return;
  }

  const selectedIdSet =
    new Set(
      selectedPieceIds
    );

  setPieces(
    (currentPieces) => {
      

      const remainingPieces =
        currentPieces.filter(
          (piece) =>
            !selectedIdSet.has(
              piece.id
            )
        );

      return normalizeOrderIdsAfterDeletion(
  remainingPieces
);
    }
  );

  clearPieceSelection();
}


function moveSelectedPieces(
  deltaX,
  deltaY
) {
  const moveX =
    Number(deltaX);

  const moveY =
    Number(deltaY);

  if (
    !Number.isFinite(moveX)
  ) {
    return;
  }

  if (
    !Number.isFinite(moveY)
  ) {
    return;
  }

  const selectedIdSet =
    new Set(
      selectedPieceIds
    );

  setPieces(
    currentPieces =>
      currentPieces.map(
        piece => {
          if (
            !selectedIdSet.has(
              piece.id
            )
          ) {
            return piece;
          }

          return {
            ...piece,

            x:
              roundToThreeDecimals(
                piece.x +
                moveX
              ),

            y:
              roundToThreeDecimals(
                piece.y +
                moveY
              )
          };
        }
      )
  );
}

function isPieceCollidingWithOtherPieces(piece) {
  

  return pieces.some(
    (otherPiece) =>
      otherPiece.id !== piece.id &&
      isPieceCollidingWithPiece(
        piece,
        otherPiece
      )
  );
}

