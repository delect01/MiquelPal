useEffect(() => {
  function handlePointerMove(
    event
  ) {
    const currentRectangle =
      selectionRectangleRef.current;

    if (!currentRectangle) {
      return;
    }

    const nextRectangle = {
      ...currentRectangle,
      currentX:
        event.clientX,
      currentY:
        event.clientY
    };

    selectionRectangleRef.current =
      nextRectangle;

    setSelectionRectangle(
      nextRectangle
    );
  }

  function handlePointerUp() {
    const currentRectangle =
      selectionRectangleRef.current;

    if (!currentRectangle) {
      return;
    }

    const width =
      Math.abs(
        currentRectangle.currentX -
        currentRectangle.startX
      );

    const height =
      Math.abs(
        currentRectangle.currentY -
        currentRectangle.startY
      );

    if (
      width >= 4 ||
      height >= 4
    ) {
      const selectedIds =
        getPieceIdsInsideRectangle({
          pieces,
          rectangle:
            currentRectangle,
          camera:
            sceneCameraRef.current,
          canvasElement:
            canvasElementRef.current
        });

      applyPieceSelection(
        selectedIds
      );
    }

    selectionRectangleRef.current =
      null;

    setSelectionRectangle(
      null
    );

    setIsDragging(false);
  }

  window.addEventListener(
    "pointermove",
    handlePointerMove
  );

  window.addEventListener(
    "pointerup",
    handlePointerUp
  );

  return () => {
    window.removeEventListener(
      "pointermove",
      handlePointerMove
    );

    window.removeEventListener(
      "pointerup",
      handlePointerUp
    );
  };
}, [
  pieces
]);











function updatePieceField(field, value) {
  if (value === "") return;

  const numericValue = parseFloat(value);

  if (isNaN(numericValue)) return;

  const positionFields = ["x", "y", "z"];

  const validatedValue = positionFields.includes(field)
    ? roundToThreeDecimals(numericValue)
    : numericValue;

  setPieces((currentPieces) =>
    currentPieces.map((piece) =>
      piece.id === selectedPieceId
        ? { ...piece, [field]: validatedValue } : piece
    )
  );
}

function updateDisplayedCoordinates(
  axis,
  displayedValue
) {

  if (displayedValue === "") return;

  const numericValue =
    parseFloat(displayedValue);

  if (isNaN(numericValue)) return;

  const displayed =
    getDisplayedCoordinates(
      selectedData
    );

  const converted =
    displayedToCenterCoordinates(
      selectedData,

      axis === "x"
        ? numericValue
        : displayed.x,

      axis === "y"
        ? numericValue
        : displayed.y,

      axis === "z"
        ? numericValue
        : displayed.z
    );

  setPieces((currentPieces) =>
    currentPieces.map((piece) =>
      piece.id === selectedPieceId
        ? {
            ...piece,

            x: roundToThreeDecimals(
              converted.x
            ),

            y: roundToThreeDecimals(
              converted.y
            ),

            z: roundToThreeDecimals(
              converted.z
            )
          }
        : piece
    )
  );
}



// Actualitza la posició d'una peça durant l'arrossegament
function movePiece(
  pieceId,
  threeX,
  threeZ
) {
  const targetPosition =
    threeToPallet(
      threeX,
      0,
      threeZ
    );

  const dragData =
    groupDragRef.current;

  if (
    !dragData ||
    dragData.sourcePieceId !==
      pieceId
  ) {
    setPieces(
      (currentPieces) =>
        currentPieces.map(
          (piece) =>
            piece.id === pieceId
              ? {
                  ...piece,

                  x:
                    roundToThreeDecimals(
                      targetPosition.x
                    ),

                  y:
                    roundToThreeDecimals(
                      targetPosition.y
                    )
                }
              : piece
        )
    );

    return;
  }

  const deltaX =
    targetPosition.x -
    dragData.startPalletX;

  const deltaY =
    targetPosition.y -
    dragData.startPalletY;

  const movingIdSet =
    new Set(
      dragData.movingPieceIds
    );

  setPieces(
    (currentPieces) =>
      currentPieces.map(
        (piece) => {
          if (
            !movingIdSet.has(
              piece.id
            )
          ) {
            return piece;
          }

          const initialPosition =
            dragData.initialPositions.get(
              piece.id
            );

          if (!initialPosition) {
            return piece;
          }

         const movedPiece = {
  ...piece,

  x:
    roundToThreeDecimals(
      initialPosition.x +
      deltaX
    ),

  y:
    roundToThreeDecimals(
      initialPosition.y +
      deltaY
    )
};

return applyMagneticSnap({
  movingPiece:
    movedPiece,

  allPieces:
    currentPieces,

  excludedPieceIds:
    dragData.movingPieceIds
});

        }
