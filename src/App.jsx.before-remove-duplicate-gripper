function saveCurrentLayer(
  forcedName = null
) {

const validation =
  getOrderIdValidation(
    pieces
  );

if (!validation.isValid) {
  setOrderIdErrorDialog({
    open: true,

    message:
      createOrderIdErrorMessage(
        validation
      )
  });

  setShowOrderIds(
    true
  );

  return null;
}


  const nameToUse =
    typeof forcedName === "string"
      ? forcedName
      : layerName;

  const cleanName =
    nameToUse.trim();

  const finalName =
    cleanName ||
    activeLayer?.name ||
    t.layer.defaultName(layers.length + 1);

  const normalizedFinalName =
    finalName.toLowerCase();

  const currentDate =
    new Date().toISOString();

  /*
    Comprovem si el nom escrit és exactament
    el mateix que el de la capa activa.
  */
  const isUpdatingActiveLayer =
    Boolean(
      activeLayer &&
      activeLayer.name
        .toLowerCase() ===
        normalizedFinalName
    );

  /*
    També comprovem si existeix una altra
    capa guardada amb aquest mateix nom.
  */
  const existingLayerByName =
    layers.find(
      (layer) =>
        layer.name
          .toLowerCase() ===
        normalizedFinalName
    );

  /*
    Decidim quin ID s'ha d'utilitzar:

    1. Mateix nom que la capa activa:
       actualitzem la capa activa.

    2. Nom d'una altra capa existent:
       actualitzem aquella capa.

    3. Nom completament nou:
       creem un ID nou.
  */
  const layerIdToUse =
    isUpdatingActiveLayer
      ? activeLayer.id
      : existingLayerByName?.id ??
        createLayerId();

  const existingLayer =
    layers.find(
      (layer) =>
        layer.id ===
        layerIdToUse
    );

const normalizedPieces =
  pieces.map(
    (piece) => ({
      ...piece,

      orderId:
        Number(
          piece.orderId
        )
    })
  );



  const layerToSave = {
    id: layerIdToUse,
    name: finalName,

    createdAt:
      existingLayer?.createdAt ??
      currentDate,

    updatedAt:
      currentDate,

    pieces:
  cloneLayerPieces(
    normalizedPieces
  )
  };

  setLayers(
    (currentLayers) => {
      const layerExists =
        currentLayers.some(
          (layer) =>
            layer.id ===
            layerToSave.id
        );

      if (layerExists) {
        return currentLayers.map(
          (layer) =>
            layer.id ===
            layerToSave.id
              ? layerToSave
              : layer
        );
      }

      return [
        ...currentLayers,
        layerToSave
      ];
    }
  );

  setActiveLayerId(
    layerToSave.id
  );

  setLayerName(
    layerToSave.name
  );

  setHasUnsavedChanges(true);

  return layerToSave;
}

