import { useEffect, useState } from "react";
import GripperPreview from "./GripperPreview.jsx";

const STORAGE_KEY = "pallet-simulator-gripper-library";

function loadLibrary() {
  try {
    const value = window.localStorage.getItem(STORAGE_KEY);
    const parsed = value ? JSON.parse(value) : [];
    return Array.isArray(parsed) ? parsed : [];
  } catch (error) {
    console.error("No s'ha pogut carregar la biblioteca de grippers:", error);
    return [];
  }
}

function saveLibrary(items) {
  try {
    window.localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
    return true;
  } catch (error) {
    console.error("No s'ha pogut guardar la biblioteca de grippers:", error);
    return false;
  }
}

function createForm(gripper) {
  return {
    name: gripper?.name || "",
    sizeX: Number(gripper?.sizeX ?? 300),
    sizeY: Number(gripper?.sizeY ?? 180),
    sizeZ: Number(gripper?.sizeZ ?? 80),
    offsetX: Number(gripper?.offsetX ?? 0),
    offsetY: Number(gripper?.offsetY ?? 0),
    robotFrontDeg: Number(gripper?.robotFrontDeg ?? 0),
    color: gripper?.color || "#64748b",
    modelType: gripper?.modelType || "BOX",
    modelData: gripper?.modelData || null
  };
}

export default function GripperDialog({
  open,
  activeGripper,
  onClose,
  onApplyGripper
}) {
  const [form, setForm] = useState(() => createForm(activeGripper));
  const [library, setLibrary] = useState(loadLibrary);
  const [selectedId, setSelectedId] = useState("");
  const [feedback, setFeedback] = useState("");

  useEffect(() => {
    if (!open) {
      return;
    }

    setForm(createForm(activeGripper));
    setLibrary(loadLibrary());
    setSelectedId("");
    setFeedback("");
  }, [open, activeGripper]);

  if (!open) {
    return null;
  }

  function update(field, value) {
    setForm((current) => ({
      ...current,
      [field]: value
    }));
    setFeedback("");
  }

  function validatedData() {
    const sizeX = Number(form.sizeX);
    const sizeY = Number(form.sizeY);
    const sizeZ = Number(form.sizeZ);
    const offsetX = Number(form.offsetX);
    const offsetY = Number(form.offsetY);
    const robotFrontDeg = Number(form.robotFrontDeg);

    if (![sizeX, sizeY, sizeZ].every((value) => Number.isFinite(value) && value > 0)) {
      setFeedback("Les mides X, Y i Z han de ser superiors a zero.");
      return null;
    }

    if (![offsetX, offsetY, robotFrontDeg].every(Number.isFinite)) {
      setFeedback("Els desplaçaments i Robot Front han de ser nombres vàlids.");
      return null;
    }

    return {
      ...form,
      name: form.name.trim(),
      sizeX,
      sizeY,
      sizeZ,
      offsetX,
      offsetY,
      robotFrontDeg
    };
  }

  function handleSave() {
    const data = validatedData();
    if (!data) {
      return;
    }

    if (!data.name) {
      setFeedback("Escriu un nom abans de guardar la gripper.");
      return;
    }

    const existing = library.find(
      (item) => item.name.toLowerCase() === data.name.toLowerCase()
    );

    const item = {
      ...data,
      id: existing?.id || window.crypto?.randomUUID?.() || `${Date.now()}-${Math.random()}`
    };

    const next = existing
      ? library.map((candidate) => candidate.id === existing.id ? item : candidate)
      : [...library, item];

    if (!saveLibrary(next)) {
      setFeedback("No s'ha pogut guardar la gripper.");
      return;
    }

    setLibrary(next);
    setSelectedId(item.id);
    setFeedback(existing ? "La gripper s'ha actualitzat." : "La gripper s'ha guardat.");
  }

  function handleSelect(id) {
    setSelectedId(id);
    const item = library.find((candidate) => candidate.id === id);
    if (!item) {
      return;
    }

    setForm(createForm(item));
    setFeedback(`Gripper carregada: ${item.name}`);
  }

  function handleDelete() {
    if (!selectedId) {
      return;
    }

    const next = library.filter((item) => item.id !== selectedId);
    if (!saveLibrary(next)) {
      return;
    }

    setLibrary(next);
    setSelectedId("");
    setFeedback("La gripper s'ha eliminat de la biblioteca.");
  }

  function handleApply() {
    const data = validatedData();
    if (!data) {
      return;
    }

    onApplyGripper({
      ...data,
      id: selectedId || activeGripper?.id || "active-gripper"
    });
    onClose();
  }

  const inputStyle = {
    width: "100%",
    height: "32px",
    boxSizing: "border-box",
    padding: "0 8px",
    border: "1px solid #aeb6bf",
    borderRadius: "5px"
  };

  const rowStyle = {
    display: "grid",
    gridTemplateColumns: "72px 1fr",
    gap: "8px",
    alignItems: "center",
    marginBottom: "8px",
    color: "#404850",
    fontSize: "13px",
    fontWeight: 600
  };

  const smallFieldStyle = {
    display: "flex",
    flexDirection: "column",
    gap: "4px",
    color: "#404850",
    fontSize: "11px",
    fontWeight: 600
  };

  return (
    <div
      role="dialog"
      aria-modal="true"
      aria-label="Configurar gripper"
      style={{
        position: "fixed",
        inset: 0,
        zIndex: 1200,
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        padding: "20px",
        background: "rgba(20, 25, 30, 0.72)"
      }}
    >
      <div
        style={{
          width: "min(1000px, 96vw)",
          maxHeight: "94vh",
          overflowY: "auto",
          padding: "16px",
          boxSizing: "border-box",
          borderRadius: "10px",
          background: "#ffffff",
          boxShadow: "0 18px 60px rgba(0, 0, 0, 0.35)"
        }}
      >
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: "12px" }}>
          <div>
            <h2 style={{ margin: 0 }}>Configurador gripper</h2>
            <div style={{ marginTop: "4px", color: "#59636e", fontSize: "13px" }}>
              La cara fosca és la cara de contacte. La Z blava indica la direcció d'atac.
            </div>
          </div>
          <button type="button" onClick={onClose} style={{ width: "38px", height: "38px", border: "1px solid #b8c0c8", borderRadius: "50%", background: "#f4f6f8", fontSize: "20px", cursor: "pointer" }}>×</button>
        </div>

        <div style={{ display: "grid", gridTemplateColumns: "minmax(300px, 380px) minmax(420px, 1fr)", gap: "16px" }}>
          <div>
            <section style={{ padding: "12px", border: "1px solid #d7dce1", borderRadius: "7px", marginBottom: "10px" }}>
              <h3 style={{ margin: "0 0 8px", fontSize: "16px" }}>Biblioteca de grippers</h3>
              <select value={selectedId} onChange={(event) => handleSelect(event.target.value)} style={{ width: "100%", height: "36px", border: "1px solid #aeb6bf", borderRadius: "5px", padding: "0 8px" }}>
                <option value="" disabled>Llistat</option>
                {[...library].sort((a, b) => a.name.localeCompare(b.name, "ca", { sensitivity: "base" })).map((item) => (
                  <option key={item.id} value={item.id}>{item.name}</option>
                ))}
              </select>

              <div style={{ display: "flex", gap: "8px", marginTop: "10px" }}>
                <button type="button" onClick={handleDelete} disabled={!selectedId} style={{ flex: 1, padding: "8px", border: "1px solid #b02a37", borderRadius: "5px", background: selectedId ? "#ffffff" : "#eceff2", color: selectedId ? "#b02a37" : "#7b848d", cursor: selectedId ? "pointer" : "not-allowed" }}>Eliminar gripper</button>
                <button type="button" onClick={() => setFeedback("La importació 3D es programarà a la fase següent.")} style={{ flex: 1, padding: "8px", border: "1px solid #2767c5", borderRadius: "5px", background: "#ffffff", color: "#2767c5", cursor: "pointer" }}>Importar 3D</button>
              </div>
            </section>

            <section style={{ padding: "12px", border: "1px solid #d7dce1", borderRadius: "7px" }}>
              <h3 style={{ margin: "0 0 10px", fontSize: "16px" }}>Geometria</h3>

              <label style={{ ...rowStyle, gridTemplateColumns: "1fr" }}>
                Nom
                <input value={form.name} onChange={(event) => update("name", event.target.value)} style={inputStyle} />
              </label>

              <label style={rowStyle}><span>Mida X</span><input type="number" min="1" value={form.sizeX} onChange={(event) => update("sizeX", event.target.value)} style={inputStyle} /></label>
              <label style={rowStyle}><span>Mida Y</span><input type="number" min="1" value={form.sizeY} onChange={(event) => update("sizeY", event.target.value)} style={inputStyle} /></label>
              <label style={rowStyle}><span>Mida Z</span><input type="number" min="1" value={form.sizeZ} onChange={(event) => update("sizeZ", event.target.value)} style={inputStyle} /></label>

              <div style={{ display: "grid", gridTemplateColumns: "repeat(3, minmax(0, 1fr))", gap: "7px", marginBottom: "9px" }}>
                <label style={smallFieldStyle}>
                  Desplaçar X
                  <input type="number" step="1" value={form.offsetX} onChange={(event) => update("offsetX", event.target.value)} style={inputStyle} />
                </label>

                <label style={smallFieldStyle}>
                  Desplaçar Y
                  <input type="number" step="1" value={form.offsetY} onChange={(event) => update("offsetY", event.target.value)} style={inputStyle} />
                </label>

                <label style={smallFieldStyle}>
                  Robot Front
                  <input type="number" step="1" value={form.robotFrontDeg} onChange={(event) => update("robotFrontDeg", event.target.value)} style={inputStyle} />
                </label>
              </div>

              <label style={rowStyle}><span>Color</span><input type="color" value={form.color} onChange={(event) => update("color", event.target.value)} style={{ ...inputStyle, padding: "2px" }} /></label>

              <button type="button" onClick={handleSave} style={{ width: "100%", marginTop: "4px", padding: "9px", border: "none", borderRadius: "6px", background: "#2767c5", color: "#ffffff", fontWeight: 700, cursor: "pointer" }}>
                Guardar nom i característiques
              </button>

              {feedback && (
                <div style={{ marginTop: "10px", padding: "8px", borderRadius: "5px", background: "#eef4fb", color: "#244d7c", fontSize: "13px" }}>{feedback}</div>
              )}
            </section>
          </div>

          <div>
            <h3 style={{ margin: "0 0 8px", fontSize: "16px" }}>Previsualització 3D</h3>
            <GripperPreview
              sizeX={form.sizeX}
              sizeY={form.sizeY}
              sizeZ={form.sizeZ}
              offsetX={form.offsetX}
              offsetY={form.offsetY}
              robotFrontDeg={form.robotFrontDeg}
              color={form.color}
            />
          </div>
        </div>

        <div style={{ display: "flex", justifyContent: "flex-end", gap: "8px", marginTop: "14px", paddingTop: "12px", borderTop: "1px solid #d7dce1" }}>
          <button type="button" onClick={onClose} style={{ padding: "10px 18px", border: "1px solid #9ea7b0", borderRadius: "6px", background: "#ffffff", cursor: "pointer" }}>Cancel·lar</button>
          <button type="button" onClick={handleApply} style={{ padding: "10px 22px", border: "none", borderRadius: "6px", background: "#168447", color: "#ffffff", fontWeight: 700, cursor: "pointer" }}>Aplicar gripper</button>
        </div>
      </div>
    </div>
  );
}
