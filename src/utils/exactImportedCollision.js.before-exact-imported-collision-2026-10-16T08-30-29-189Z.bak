import * as THREE from "three";
import { getPieceCenter, palletEulerToThreeQuaternion } from "./pieceUtils";

const EPSILON = 1e-7;

export function getExactWorldMesh(piece) {
  const exact = piece.collisionGeometry?.exact;
  if (!exact?.vertices?.length || !exact?.triangles?.length) return null;
  const centerData = getPieceCenter(piece);
  const center = new THREE.Vector3(centerData.x, centerData.y, centerData.z);
  const quaternion = palletEulerToThreeQuaternion(
    piece.rxDeg ?? 0,
    piece.ryDeg ?? 0,
    piece.rzDeg ?? 0
  );
  return {
    vertices: exact.vertices.map((v) =>
      new THREE.Vector3(Number(v.x), Number(v.y), Number(v.z))
        .applyQuaternion(quaternion)
        .add(center)
    ),
    triangles: exact.triangles
  };
}

function box(vertices, triangle) {
  return new THREE.Box3().setFromPoints(triangle.map((i) => vertices[i]));
}
function projection(points, axis) {
  let min = Infinity, max = -Infinity;
  for (const point of points) {
    const value = point.dot(axis);
    min = Math.min(min, value);
    max = Math.max(max, value);
  }
  return { min, max };
}
function separated(a, b, axis, tolerance) {
  if (axis.lengthSq() < EPSILON) return false;
  const n = axis.clone().normalize();
  const pa = projection(a, n);
  const pb = projection(b, n);
  return pa.max < pb.min - tolerance || pb.max < pa.min - tolerance;
}
function trianglesIntersect(a0, a1, a2, b0, b1, b2, tolerance) {
  const a = [a0, a1, a2];
  const b = [b0, b1, b2];
  const ae = [a1.clone().sub(a0), a2.clone().sub(a1), a0.clone().sub(a2)];
  const be = [b1.clone().sub(b0), b2.clone().sub(b1), b0.clone().sub(b2)];
  const axes = [
    new THREE.Vector3().crossVectors(ae[0], ae[1]),
    new THREE.Vector3().crossVectors(be[0], be[1])
  ];
  for (const ea of ae) for (const eb of be) {
    axes.push(new THREE.Vector3().crossVectors(ea, eb));
  }
  return !axes.some((axis) => separated(a, b, axis, tolerance));
}
function pointInsideMesh(point, mesh) {
  const direction = new THREE.Vector3(1, 0.371390676, 0.173205081).normalize();
  let hits = 0;
  for (const triangle of mesh.triangles) {
    const a = mesh.vertices[triangle[0]];
    const b = mesh.vertices[triangle[1]];
    const c = mesh.vertices[triangle[2]];
    const edge1 = b.clone().sub(a);
    const edge2 = c.clone().sub(a);
    const p = new THREE.Vector3().crossVectors(direction, edge2);
    const det = edge1.dot(p);
    if (Math.abs(det) < EPSILON) continue;
    const inv = 1 / det;
    const tvec = point.clone().sub(a);
    const u = tvec.dot(p) * inv;
    if (u < -EPSILON || u > 1 + EPSILON) continue;
    const q = new THREE.Vector3().crossVectors(tvec, edge1);
    const v = direction.dot(q) * inv;
    if (v < -EPSILON || u + v > 1 + EPSILON) continue;
    if (edge2.dot(q) * inv > EPSILON) hits += 1;
  }
  return hits % 2 === 1;
}

export function exactMeshesCollide(pieceA, pieceB, tolerance = 0) {
  const meshA = getExactWorldMesh(pieceA);
  const meshB = getExactWorldMesh(pieceB);
  if (!meshA || !meshB) return null;
  const boxesB = meshB.triangles.map((triangle) => box(meshB.vertices, triangle));

  for (const triangleA of meshA.triangles) {
    const boxA = box(meshA.vertices, triangleA).expandByScalar(tolerance);
    for (let index = 0; index < meshB.triangles.length; index += 1) {
      if (!boxA.intersectsBox(boxesB[index])) continue;
      const triangleB = meshB.triangles[index];
      if (trianglesIntersect(
        meshA.vertices[triangleA[0]], meshA.vertices[triangleA[1]], meshA.vertices[triangleA[2]],
        meshB.vertices[triangleB[0]], meshB.vertices[triangleB[1]], meshB.vertices[triangleB[2]],
        tolerance
      )) return true;
    }
  }

  if (meshA.vertices.length && pointInsideMesh(meshA.vertices[0], meshB)) return true;
  if (meshB.vertices.length && pointInsideMesh(meshB.vertices[0], meshA)) return true;
  return false;
}
